import json
import logging
from uuid import uuid4
from datetime import datetime

from services.llm_provider import generate_response
from services.ai.json_parser import JSONParser
from models import EpisodePattern, EpisodeMood, EpisodeReflection, Episode

logger = logging.getLogger(__name__)

PATTERN_PROMPT = """You identify cautious, evidence-based recurring patterns in a mental-health support journal.
Do not diagnose or infer a disorder. A pattern should be supported by multiple observations or episodes; do not label a one-off event as recurring.

Closed episode summary:
{summary}

Mood timeline:
{moods}

Reflections:
{reflections}

Existing patterns:
{existing}

Return ONLY JSON: {{\"patterns\":[{{\"category\":\"trigger|coping|mood|behavior|general\",\"description\":\"concise pattern\",\"confidence\":0.0,\"evidence\":[\"specific evidence\"],\"status\":\"ACTIVE|RESOLVED\"}}]}}
Return an empty patterns array when evidence is insufficient. Confidence must be 0..1."""

class PatternDetector:
    def __init__(self):
        self.parser = JSONParser()

    def detect_and_save(self, db, episode):
        moods = db.query(EpisodeMood).filter(EpisodeMood.episode_id == episode.episode_id).order_by(EpisodeMood.created_at).all()
        reflections = db.query(EpisodeReflection).filter(EpisodeReflection.episode_id == episode.episode_id).order_by(EpisodeReflection.created_at).all()
        existing = db.query(EpisodePattern).filter(EpisodePattern.user_id == episode.user_id).all()
        prior_episodes = db.query(Episode).filter(Episode.user_id == episode.user_id, Episode.status == "CLOSED", Episode.episode_id != episode.episode_id).order_by(Episode.closed_at.desc()).limit(8).all()
        existing_text = "\n".join(f"{p.pattern_id}: {p.description} [{p.status}]" for p in existing) or "None"
        prior_text = "\n".join(f"Episode ID: {e.episode_id}\nSummary: {e.summary or 'No summary'}" for e in prior_episodes)
        allowed_episode_ids = {episode.episode_id, *(e.episode_id for e in prior_episodes)}
        mood_text = "\n".join(f"{m.created_at}: {m.mood} ({m.confidence})" for m in moods) or "None"
        reflection_text = "\n".join(f"- {r.reflection}" for r in reflections) or "None"
        prompt = PATTERN_PROMPT.format(summary=(episode.summary or "") + "\n\nRecent previous episode summaries:\n" + prior_text, moods=mood_text, reflections=reflection_text, existing=existing_text)
        raw = generate_response(prompt)
        parsed = self.parser.parse(raw) if raw else None
        if not isinstance(parsed, dict) or not isinstance(parsed.get("patterns"), list):
            logger.warning("Pattern detector returned invalid structure for %s", episode.episode_id)
            return []
        saved = []
        for item in parsed["patterns"]:
            if not isinstance(item, dict):
                continue
            desc = item.get("description")
            try: confidence = float(item.get("confidence"))
            except (TypeError, ValueError): continue
            evidence = item.get("evidence")
            if not isinstance(desc, str) or not desc.strip() or not 0.0 <= confidence <= 1.0 or not isinstance(evidence, list) or not evidence:
                continue
            # Persist only evidence tied to an episode ID actually supplied
            # to the model; this prevents fabricated provenance.
            grounded_evidence = [
                {"episode_id": entry.get("episode_id"), "detail": entry.get("detail", "")}
                for entry in evidence
                if isinstance(entry, dict)
                and entry.get("episode_id") in allowed_episode_ids
                and isinstance(entry.get("detail"), str)
                and entry.get("detail", "").strip()
            ]
            if not grounded_evidence:
                continue
            category = str(item.get("category") or "general")[:80]
            status = "RESOLVED" if str(item.get("status", "ACTIVE")).upper() == "RESOLVED" else "ACTIVE"
            # Merge with an existing pattern when the model identifies the same description.
            match = next((p for p in existing if p.description.casefold() == desc.strip().casefold()), None)
            if match:
                match.confidence = max(match.confidence, confidence)
                match.last_seen_at = datetime.utcnow()
                match.status = status
                match.evidence = list(match.evidence or []) + grounded_evidence
                saved.append(match)
            else:
                record = EpisodePattern(pattern_id=f"PAT_{uuid4().hex[:10].upper()}", user_id=episode.user_id, category=category, description=desc.strip(), confidence=confidence, evidence=grounded_evidence, status=status)
                db.add(record); saved.append(record)
        db.commit()
        return saved
